# Copy this file to .env and fill in real values for local development.
# See the README's "Environment variables" section for what each one does,
# and config/env.ts for the validation each one goes through at startup.

NODE_ENV=development

# HTTP port the API listens on.
PORT=3000

# Comma-separated list of origins allowed to call the API from a browser.
# The default (below) matches the frontend's own default dev port.
CORS_ORIGINS=http://localhost:5173

# Required. A PostgreSQL connection string — any local PostgreSQL 16+
# install works (Postgres.app, Homebrew, a system package, a Neon
# development branch). No Docker required.
DATABASE_URL=postgres://localhost:5432/jambo_dev

# Required, at least 32 characters. Generate one with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-real-random-secret-at-least-32-characters-long

# How long an access token stays valid, in seconds. 900 = 15 minutes.
ACCESS_TOKEN_TTL_SECONDS=900

# Upstream base URLs — the defaults below are the real providers; only
# override these for local integration testing against a stub server.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
WIKIPEDIA_BASE_URL=https://en.wikipedia.org
IP_GEOLOCATION_BASE_URL=https://ipwho.is

# Sent as the User-Agent header on every Wikipedia request, per Wikimedia's
# policy — https://foundation.wikimedia.org/wiki/Policy:Wikimedia_Foundation_User-Agent_Policy.
# Set this to a real contact URL (yours) before deploying to production;
# the placeholder below is fine for local development.
WIKIPEDIA_USER_AGENT=JamboTravelPlanner/0.1 (local-development; set WIKIPEDIA_USER_AGENT for production) node

# The city shown when IP detection can't run (local dev) or doesn't
# produce a usable result — must be a real id in domain/city-catalogue.ts.
DEFAULT_CITY_ID=calgary

# Reverse-proxy hop count for Express's `trust proxy` setting. 0 for local
# development (no proxy in front); 1 in production behind Render's load
# balancer — see the README's IP-based geolocation section.
TRUST_PROXY_HOPS=0

# --- Not validated by config/env.ts — read directly by one-off scripts ---

# A second PostgreSQL database (or the same server, different database)
# used only by integration tests and `npm run db:migrate:test`. Never the
# same database as DATABASE_URL, so tests can freely truncate tables.
TEST_DATABASE_URL=postgres://localhost:5432/jambo_test

# Seed data for `npm run db:seed -w @jambo/api`, format
# "email1:password1,email2:password2". Not read by the running server.
SEED_USERS=demo@example.com:a-real-password-you-choose
